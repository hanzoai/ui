{
  "name": "@hanzo/og",
  "version": "1.0.3",
  "description": "Programmatic OpenGraph image generation for Hanzo sites",
  "scripts": {
    "prepublishOnly": "node ../../scripts/guard-publish.mjs",
    "build": "tsc -p tsconfig.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "peerDependencies": {
    "react": ">=19.2"
  },
  "keywords": [
    "og",
    "opengraph",
    "social",
    "seo",
    "hanzo"
  ],
  "dependencies": {
    "@hanzo/font": "catalog:",
    "@hanzo/logo": "catalog:",
    "@resvg/resvg-js": "^2.6.2",
    "satori": "0.12.2"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:"
  }
