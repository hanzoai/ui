{
  "name": "@hanzo/composer",
  "version": "0.2.0",
  "description": "The composer's material — the lit ring around anything you can type into, as @hanzo/gui components.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "node ../../scripts/guard-publish.mjs",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node ../ui/scripts/postbuild.mjs .",
    "clean": "rm -rf dist",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "tc": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "MIT",
  "peerDependencies": {
    "@hanzo/gui": "^8.3.5",
    "react": ">=19.2.8"
  },
  "devDependencies": {
    "@hanzo/gui": "catalog:",
    "@hanzogui/config": "catalog:",
    "@hanzogui/core": "catalog:",
    "@hanzogui/web": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native-web": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
