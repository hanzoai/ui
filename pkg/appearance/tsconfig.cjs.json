{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    // `moduleResolution` is INHERITED. It was stated as "node" because
    // TypeScript 5 rejects `bundler` with a CommonJS target (TS5095); TypeScript
    // 7 removed node10 outright (TS5108) and allows the inherited `bundler`
    // here, so naming it is now the error. Types and maps come from the ESM
    // pass — emitting them twice writes two .d.ts for one set of declarations.
    "module": "commonjs",
    "outDir": "./dist-cjs",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  }
}
