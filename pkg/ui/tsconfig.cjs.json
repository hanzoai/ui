{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    // Only the module format is overridden. `moduleResolution` is INHERITED, and
    // must not be stated: TypeScript 7 removed `node10` (TS5108), and it also
    // dropped the TS5095 rule that `bundler` resolution needs an ES module
    // target — so the base config's `bundler` is correct beside `commonjs` here.
    //
    // Under TypeScript 5 those two facts were reversed, which is why this file
    // used to name `node`. That is also why the CJS pass is worth watching when
    // the compiler moves: it emits nothing at all when the pair disagrees, and a
    // package with no `require` build still installs.
    "module": "commonjs",
    "outDir": "./dist-cjs",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  }
}
