{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "./types",
    "rootDir": "./src"
  },
  "include": ["src"],
  "exclude": ["node_modules", "types", "**/*.test.ts", "**/*.test.tsx", "src/backends/svelte"]
}
