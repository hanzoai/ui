{
  "typescript.tsdk": "node_modules/.pnpm/typescript@5.3.3/node_modules/typescript/lib",
  "editor.gotoLocation.multipleDefinitions": "goto",
  "typescript.preferences.quoteStyle": "single",
  "eslint.workingDirectories": [
    {
      "pattern": "apps/*/"
    },
    {
      "pattern": "pkg/*/"
    },
    {
      "pattern": "pkgs/*/"
    }
  ],
  "vitest.debugExclude": [
    "<node_internals>/**",
    "**/node_modules/**",
    "**/fixtures/**"
  ],
  "files.exclude": {
    "deprecated": true
  },
  "search.exclude": {
    "**/dist": true
  }
}
