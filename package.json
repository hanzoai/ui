{
  "name": "ui",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "hanzo",
    "url": "https://x.com/hanzoai"
  },
  "workspaces": [
    "apps/*",
    "pkg/*",
    "pkgs/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "format:write": "turbo run format:write",
    "format:check": "turbo run format:check",
    "test": "turbo run test",
    "check": "bash scripts/check-no-brand-pkg.sh && turbo lint typecheck format:check"
  },
  "packageManager": "pnpm@9.0.6",
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@manypkg/cli": "^0.25.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "4.1.8",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-turbo": "^2.9.16",
    "eslint-plugin-react": "^7.37.5",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "pretty-quick": "^4.2.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "turbo": "^2.9.16",
    "typescript": "^7.0.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "pnpm": {
    "overrides": {
      "got@<11.8.5": ">=11.8.5",
      "axios@>=0.8.1 <0.28.0": ">=0.28.0",
      "undici@>=6.0.0 <6.21.1": ">=6.21.1",
      "esbuild@<=0.24.2": ">=0.25.0",
      "axios@<0.30.0": ">=0.30.0",
      "undici@>=6.0.0 <6.21.2": ">=6.21.2",
      "cross-spawn@<6.0.6": ">=6.0.6",
      "prismjs@<1.30.0": ">=1.30.0",
      "axios@<0.30.2": ">=0.30.2",
      "happy-dom@<20.0.0": ">=20.0.0",
      "happy-dom@<20.0.2": ">=20.0.2",
      "vite@>=5.2.6 <=5.4.20": ">=5.4.21",
      "vite@>=7.1.0 <=7.1.10": ">=7.1.11",
      "validator@<13.15.20": ">=13.15.20",
      "tar@=7.5.1": ">=7.5.2",
      "zod@>4": "4.3.6",
      "@hookform/resolvers": "3.10.0",
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3",
