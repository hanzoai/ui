{
  "name": "cd",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Hanzo CD \u2014 the dedicated deploy dashboard served at cd.hanzo.ai (a @hanzo/cd + @hanzo/canvas SPA over /v1/deploy). Replaces the ArgoCD UI fork.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "preview": "vite preview --port 4173"
  },
  "dependencies": {
    "@hanzo/canvas": "workspace:*",
    "@hanzo/cd": "workspace:*",
    "@hanzo/font": "^1.8.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.4"
  }
}
