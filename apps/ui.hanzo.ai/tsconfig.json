{
  "compilerOptions": {
    "paths": {
      "~/*": ["./*"]
    },
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "module": "Preserve",
    "target": "ES2022",
    "lib": ["dom", "esnext"],
    "types": ["node", "react", "vite/client"],
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "app",
    "components",
    "pages.ts",
    "vite.config.ts",
    "examples",
    "catalog.ts",
    "mdx.ts",
    "brand.ts",
    "features",
    "font.d.ts",
    "i18n"
  ],
  "exclude": ["node_modules", "dist"]
}
