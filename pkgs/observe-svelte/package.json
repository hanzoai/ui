{
  "name": "@hanzo/observe-svelte",
  "version": "0.1.1",
  "description": "Svelte adaptor for @hanzo/observe — default-on semantic interaction capture. A createObserver bootstrap, an `observe` action for stable component names, and a Svelte-store view of the live event stream for session playback. Emits through @hanzo/event to the ONE entry point (POST /v1/event).",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "scope": "@hanzo"
  },
  "author": "Hanzo AI <dev@hanzo.ai>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanzoai/ui.git",
    "directory": "pkgs/observe-svelte"
  },
  "keywords": [
    "analytics",
    "autocapture",
    "session-replay",
    "telemetry",
    "semantic",
    "svelte",
    "sveltekit",
    "hanzo"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --declaration --outDir dist && node ../../scripts/dts.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "dependencies": {
    "@hanzo/event": "catalog:",
    "@hanzo/observe": "catalog:"
  },
  "peerDependencies": {
    "svelte": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "happy-dom": "^20.0.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0"
  }
}
