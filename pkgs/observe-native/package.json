{
  "name": "@hanzo/observe-native",
  "version": "0.1.1",
  "description": "Native + desktop binding for @hanzo/observe. Instruments @hanzo/gui (Tamagui) / React Native presses and inputs, and bridges Tauri desktop, so native and desktop emit the SAME canonical Events as the web \u2014 through @hanzo/event to the ONE entry point (POST /v1/event). Same semantic hierarchy, same privacy gate, fail-soft.",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "scope": "@hanzo"
  },
  "author": "Hanzo AI <dev@hanzo.ai>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanzoai/ui.git",
    "directory": "pkgs/observe-native"
  },
  "keywords": [
    "analytics",
    "autocapture",
    "telemetry",
    "semantic",
    "tamagui",
    "react-native",
    "tauri",
    "hanzo"
  ],
  "scripts": {
    "prepublishOnly": "node ../../scripts/guard-publish.mjs",
    "build": "tsup && tsc --emitDeclarationOnly --declaration --outDir dist && node ../../scripts/dts.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./tauri": {
      "import": {
        "types": "./dist/tauri.d.ts",
        "default": "./dist/tauri.mjs"
      },
      "require": {
        "types": "./dist/tauri.d.cts",
        "default": "./dist/tauri.cjs"
      }
    }
  },
  "dependencies": {
    "@hanzo/event": "catalog:",
    "@hanzo/observe": "catalog:"
  },
  "peerDependencies": {
    "@tauri-apps/api": ">=2",
    "react": ">=19.2.8"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@tauri-apps/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "happy-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
