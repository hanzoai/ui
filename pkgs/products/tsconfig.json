{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["es2020"],
    "strict": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "rootDir": "src",
    "types": ["node", "react"],
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "declaration": true,
    "outDir": "dist",
    "jsx": "react-jsx",
    "skipLibCheck": true
  },
  "include": ["src"]
}
