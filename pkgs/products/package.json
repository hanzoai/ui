{
  "name": "@hanzo/products",
  "version": "0.2.6",
  "description": "The canonical Hanzo product catalog: one typed contract + icon/color code-maps + a commerce-backed client with a checked-in snapshot fallback. Single source of truth for console, docs, site, and pricing.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.mjs",
      "require": "./dist/icons.js"
    },
    "./snapshot": "./snapshot/catalog.json"
  },
  "files": [
    "dist",
    "snapshot"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --declaration --outDir dist && node ../../scripts/dts.mjs",
    "dev": "tsup --watch",
    "sync": "node scripts/sync.mjs",
    "test": "vitest run && node scripts/sync.mjs --check",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "hanzo",
    "products",
    "catalog",
    "registry",
    "taxonomy"
  ],
  "author": "Hanzo AI",
  "license": "MIT",
  "peerDependencies": {
    "@hanzogui/lucide-icons-2": "8.3.1",
    "react": ">=19.2.8"
  },
  "peerDependenciesMeta": {
    "@hanzogui/lucide-icons-2": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hanzogui/lucide-icons-2": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
