{
  "name": "@hanzo/events",
  "version": "0.2.2",
  "description": "The canonical Hanzo event schema: which events exist, what each means, and what it carries.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./catalog.json": "./dist/catalog.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist dist-cjs && tsgo -p tsconfig.json && tsgo -p tsconfig.cjs.json && node ../../pkg/ui/scripts/postbuild.mjs . index,names,schema,funnels && node scripts/catalog.mjs && node ../../pkg/ui/scripts/check-exports.mjs .",
    "test": "node --test test/*.mjs",
    "typecheck": "tsgo --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanzoai/ui.git",
    "directory": "pkgs/events"
  },
  "homepage": "https://github.com/hanzoai/ui/tree/main/pkgs/events",
  "keywords": [
    "hanzo",
    "analytics",
    "events",
    "schema",
    "taxonomy"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
