{
  "name": "@hanzo/canvas",
  "version": "0.2.3",
  "type": "module",
  "description": "Railway-grade PaaS project canvas — a pannable/zoomable board of service nodes with live status, metric sparklines, deploy timelines, an environment switcher, and a service detail drawer. Host-agnostic @hanzo/gui React surface, brand/white-label aware, shared by every Hanzo console (hanzo/lux/zoo).",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pure": {
      "types": "./dist/pure.d.ts",
      "default": "./dist/pure.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanzoai/ui.git",
    "directory": "pkgs/canvas"
  },
  "keywords": [
    "paas",
    "canvas",
    "railway",
    "service-map",
    "deployments",
    "dashboard",
    "hanzo",
    "hanzo-ai",
    "hanzoai",
    "gui",
    "react"
  ],
  "scripts": {
    "tc": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "build": "tsc --outDir dist --rootDir src --declaration --module ESNext --moduleResolution bundler --jsx react-jsx --esModuleInterop --skipLibCheck --sourceMap",
    "test": "bun test"
  },
  "peerDependencies": {
    "@hanzo/gui": ">=8.3.0",
    "@xyflow/react": ">=12",
    "react": ">=19.2.8",
    "react-dom": ">=19.2.8"
  },
  "peerDependenciesMeta": {
    "@xyflow/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hanzo/gui": "catalog:",
    "@hanzogui/config": "8.1.0",
    "@hanzogui/core": "8.1.0",
    "@hanzogui/web": "8.1.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@xyflow/react": "^12.11.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Hanzo AI <dev@hanzo.ai>"
}
